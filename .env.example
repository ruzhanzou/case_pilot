CASEPILOT_ENV=development
CASEPILOT_SEED_DEMO_DATA=true
CASEPILOT_API_HOST=0.0.0.0
CASEPILOT_API_PORT=8000
CASEPILOT_WEB_ORIGIN=http://localhost:3000

POSTGRES_DB=casepilot
POSTGRES_USER=casepilot
POSTGRES_PASSWORD=casepilot-local
DATABASE_URL=postgresql+psycopg://casepilot:casepilot-local@postgres:5432/casepilot

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

NEXT_PUBLIC_CASEPILOT_API_URL=http://localhost:8000
CASEPILOT_AI_MODE=mock
CASEPILOT_AGENT_PROVIDER=mock
CASEPILOT_AGENT_PROVIDER_LABEL=本地 Mock
CASEPILOT_AGENT_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
CASEPILOT_AGENT_API_KEY=
CASEPILOT_AGENT_MODEL=doubao-seed-2.0-lite
CASEPILOT_AGENT_PRO_MODEL=deepseek-v4-pro
CASEPILOT_AGENT_LOCAL_MODEL=ark-code-latest
# 逗号分隔；这些模型会直接展示在 AI 工作台的模型选择器中。
CASEPILOT_AGENT_MODELS=ark-code-latest,doubao-seed-2.0-lite,glm-5.2,kimi-k2.7-code,deepseek-v4-pro,deepseek-v4-flash,minimax-m3,minimax-m2.7,kimi-k2.6,doubao-seed-2.1-turbo
CASEPILOT_EMBEDDING_PROVIDER=mock
# 可与 Chat 使用不同的 OpenAI-compatible 服务；留空时回退到 Agent 地址与密钥。
CASEPILOT_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
CASEPILOT_EMBEDDING_API_KEY=
CASEPILOT_EMBEDDING_MODEL=doubao-embedding-vision
CASEPILOT_EMBEDDING_DIMENSIONS=2048
CASEPILOT_EMBEDDING_TIMEOUT_SECONDS=60
CASEPILOT_EMBEDDING_FALLBACK_ENABLED=true
CASEPILOT_AGENT_TIMEOUT_SECONDS=120
# 非 OpenAI Provider 默认关闭 SDK tracing；仅在明确配置追踪接收端时开启。
CASEPILOT_AGENT_TRACING_ENABLED=false
CASEPILOT_KNOWLEDGE_STORAGE_PATH=/var/lib/casepilot/knowledge
CASEPILOT_SESSION_COOKIE_NAME=casepilot_session
CASEPILOT_SESSION_TTL_HOURS=168

# TestWeb -> Case Service / TestTool -> Case Service authentication.
CASE_SERVICE_API_TOKEN=case-service-local
TEST_TOOL_API_TOKEN=test-tool-local
# Case Service -> TestWeb callback authentication and delivery.
TEST_WEB_BASE_URL=http://127.0.0.1:8090
TEST_WEB_CALLBACK_TOKEN=test-web-local
CASE_SERVICE_CALLBACK_TIMEOUT_SECONDS=10
# Deep links returned to TestWeb.
CASE_PLATFORM_BASE_URL=http://127.0.0.1:3000
# Optional. If omitted, the first owner space is used unless space_id is sent.
CASE_SERVICE_DEFAULT_SPACE_ID=
# The integration generator is intentionally deterministic during mock testing.
CASE_SERVICE_MOCK_MODE=true
CASE_SERVICE_GENERATION_PROMPT=基于给定测试目标和上下文生成可执行测试用例，至少覆盖核心路径、异常恢复、稳定性与回归。
TEST_TOOL_LEASE_SECONDS=300
