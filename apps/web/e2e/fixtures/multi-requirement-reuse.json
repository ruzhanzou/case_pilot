    {
      "id": "E01",
      "name": "青禾图书借阅",
      "strategy": "fresh",
      "requirements": [
        {
          "id": "E01-R1",
          "text": "普通读者当前借阅数量为0且目标书可借时，借阅成功；",
          "expected_result_pattern": "借阅成功"
        },
        {
          "id": "E01-R2",
          "text": "普通读者已有5本未归还图书时，再借第6本被拒绝，提示借阅数量已达上限；",
          "expected_result_pattern": "上限|不能借阅|无法借阅"
        },
        {
          "id": "E01-R3",
          "text": "目标图书库存为0时，借阅被拒绝，提示暂无可借图书。",
          "expected_result_pattern": "暂无可借|库存不足"
        }
      ],
      "assets": [],
      "excel": [],
      "expected_counts": {
        "new": 3,
        "reuse": 0,
        "modify": 0
      },
      "forbidden_in_modified": []
    },
    {
      "id": "E02",
      "name": "云杉购物车回归",
      "strategy": "regression",
      "requirements": [
        {
          "id": "E02-R1",
          "text": "已登录用户将有库存商品加入购物车，商品出现在购物车中；规则不变，直接复用核心用例。",
          "expected_result_pattern": "购物车"
        },
        {
          "id": "E02-R2",
          "text": "购物车已有1件商品，用户删除该商品后购物车为空；规则不变，直接复用核心用例。",
          "expected_result_pattern": "为空|空购物车"
        },
        {
          "id": "E02-R3",
          "text": "新增：同款商品购物车数量最多10件，从10件增加到11件被拒绝，提示已达数量上限。",
          "expected_result_pattern": "上限|最多10|不允许.*11"
        }
      ],
      "assets": [
        {
          "title": "云杉购物车回归：加入有库存商品",
          "module": "云杉购物车回归",
          "priority": "P1",
          "case_type": "功能",
          "preconditions": [
            "用户已登录，目标商品有库存，购物车为空"
          ],
          "steps": [
            {
              "action": "将该商品加入购物车",
              "expected": "该商品出现在购物车中"
            }
          ]
        },
        {
          "title": "云杉购物车回归：删除唯一商品",
          "module": "云杉购物车回归",
          "priority": "P1",
          "case_type": "功能",
          "preconditions": [
            "用户已登录，购物车已有1件商品"
          ],
          "steps": [
            {
              "action": "删除该商品",
              "expected": "购物车为空"
            }
          ]
        }
      ],
      "excel": [],
      "expected_counts": {
        "reuse": 2,
        "modify": 0,
        "new": 1
      },
      "forbidden_in_modified": []
    },
    {
