          "expected_result_pattern": "过期"
        },
        {
          "id": "E03-R3",
          "text": "新增同一手机号发送后60秒内不能重复发送，提示稍后重试。",
          "expected_result_pattern": "稍后重试"
        }
      ],
      "assets": [
        {
          "title": "星桥验证码改版：有效验证码登录",
          "module": "星桥验证码改版",
          "priority": "P1",
          "case_type": "功能",
          "preconditions": [
            "手机号已注册，持有刚发送且未使用的正确验证码"
          ],
          "steps": [
            {
              "action": "输入手机号与正确验证码提交登录",
              "expected": "登录成功"
            }
          ]
        },
        {
          "title": "星桥验证码改版：验证码5分钟过期",
          "module": "星桥验证码改版",
          "priority": "P1",
          "case_type": "功能",
          "preconditions": [
            "手机号已注册，验证码已发送超过5分钟"
          ],
          "steps": [
            {
              "action": "输入该手机号和超过5分钟的验证码提交登录",
              "expected": "登录失败，提示验证码已过期"
            }
          ]
        }
      ],
      "excel": [],
      "expected_counts": {
        "reuse": 1,
        "modify": 1,
        "new": 1
      },
      "forbidden_in_modified": [
