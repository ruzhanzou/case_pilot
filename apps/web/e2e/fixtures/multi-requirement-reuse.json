    {
      "id": "E06",
      "name": "海岚优惠券规则辨别",
      "strategy": "change",
      "requirements": [
        {
          "id": "E06-R1",
          "text": "满减门槛从满500元改为满800元减50元，订单金额600元时使用此券应被拒绝，提示未达门槛。历史用例同名但预期已经失效，必须修改，不能直接复用。",
          "expected_result_pattern": "未达.*门槛|不满足.*门槛"
        },
        {
          "id": "E06-R2",
          "text": "订单金额恰好800元时使用此券，应减免50元，实付750元。",
          "expected_result_pattern": "750"
        },
        {
          "id": "E06-R3",
          "text": "优惠券已过期时，即使金额800元也不可使用，提示优惠券已过期。",
          "expected_result_pattern": "已过期"
        }
      ],
      "assets": [
        {
          "title": "海岚优惠券规则辨别：600元订单使用满减券",
          "module": "海岚优惠券规则辨别",
          "priority": "P1",
          "case_type": "功能",
          "preconditions": [
            "优惠券有效，旧规则满500元减50元，订单金额600元"
          ],
          "steps": [
            {
              "action": "提交订单并使用该优惠券",
              "expected": "优惠券使用成功，实付550元"
            }
          ]
        }
      ],
