    {
      "id": "E05",
      "name": "北辰会员积分",
      "strategy": "change",
      "requirements": [
        {
          "id": "E05-R1",
          "text": "普通会员成功支付100元订单后获得100积分；规则不变，直接复用资产中的用例。",
          "expected_result_pattern": "100积分"
        },
        {
          "id": "E05-R2",
          "text": "积分兑换规则由100积分抵1元改成200积分抵1元，使用200积分抵扣后应抵扣1元。修改Excel历史用例。",
          "expected_result_pattern": "1元"
        },
        {
          "id": "E05-R3",
          "text": "新增：会员积分余额不足200时，申请抵扣1元被拒绝，提示积分不足。",
          "expected_result_pattern": "积分不足"
        }
      ],
      "assets": [
        {
          "title": "北辰会员积分：支付获得积分",
          "module": "北辰会员积分",
          "priority": "P1",
          "case_type": "功能",
          "preconditions": [
            "普通会员已登录，积分余额为0，有待支付100元订单"
          ],
          "steps": [
            {
              "action": "成功支付该100元订单",
              "expected": "获得100积分，余额为100积分"
            }
          ]
        }
      ],
      "excel": [
        {
          "title": "北辰会员积分：积分抵扣",
          "module": "北辰会员积分",
          "priority": "P1",
          "case_type": "功能",
          "preconditions": [
            "会员余额为200积分，兑换规则100积分抵1元"
          ],
          "steps": [
            {
              "action": "使用200积分抵扣订单金额",
              "expected": "抵扣2元，积分余额为0"
            }
          ]
        }
      ],
      "expected_counts": {
        "reuse": 1,
        "modify": 1,
        "new": 1
      },
